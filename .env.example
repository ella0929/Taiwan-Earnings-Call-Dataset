# Copy to .env and fill locally. Never commit real credentials.
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=your_database
HF_TOKEN=your_huggingface_read_token
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
# Leave empty to detect the spoken language.
WHISPER_LANGUAGE=
WHISPER_HOTWORDS=
WHISPER_BEAM_SIZE=5
